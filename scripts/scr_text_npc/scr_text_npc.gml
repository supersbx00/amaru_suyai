function scr_text_npc() {
switch (npc)
{
    case "tejedora":
        texto[0] = "Hola ¿Quieres saber lo que estoy haciendo?#Bueno estoy tejiendo con cuerdas hechas del junquillo o totora, esto#me permite realizar los faldellines que ves alrededor de esta cueva.";
        break;
    
    case "espiritu_luna_camarones":
        texto[0] = "Te he traído a Camarones ¿Por qué dices tu? bueno esta zona es#una de las más importante de nuestra cultura, ya que aquí se dio#origen a nuestro ritual fúnebre conocido como proceso de momificación";
        break;
    
    case "espiritu_luna_camarones2":
        texto[0] = "Vamos todavía tienes mucho que aprender respecto a tu cultura,#aun no tienes los conocimientos necesarios para enfrentar a Khoru.#Debemos pedir ayuda y sé dónde encontrarla.";
        break;
    
    case "npc31":
        texto[0] = "¡Amaru! sería bueno que hables con la gente de la zona así podrías#aprender más sobre nuestra cultura.";
        texto[1] = "Me preocupa un poco esa mujer se ve sospechosa, creo#que deberías intentar hablar con ella parece#qué está preocupada por algo.";
        break;
    
    case "npc31_2":
        texto[0] = "Así que ella resultaba ser alguna clase de espíritu...#¡Amaru! ¡Amaru! te está llamando creo que deberiamos hablar con#ella, a lo mejor tiene respuestas de lo que está ocurriendo.";
        break;
    
    case "Final":
        texto[0] = "Whanku: Yo te ayude en su momento para salvarla, pero#no de esta manera el mundo necesita a los espiritus y ellos a nosotros.";
        texto[1] = "Khoru: Maldito traidoorr ahhggg...";
        texto[2] = "Whanku: Amaru has salvado nuestra Cultura y el legado del mundo...";
        break;
    
    case "pescador_humedal":
        texto[0] = "Te daré la clave de realizar un buen anzuelo, este está confeccionado#con huesos de aves y cuerdas de fibra vegetal, en el extremo se amarran#dos piedras para que este pueda hundirse debajo del agua y así poder#extraer el pescado recolectado en el mar.";
        texto[1] = "¿Te gustaría confeccionar uno, para poder realizar la caza de peces?#¡Ten toma! Atrapa tanto peces como puedas";
        texto[2] = "[Ahora puedes confeccionar Anzuelo de hueso de Ave]";
        break;
    
    case "pescador_estolica":
        texto[0] = "¡Shhh! Silencio, estoy buscando algún animal con mi estólica #de madera.";
        texto[1] = "Te apuesto que no sabes lo que es una estólica#Ja Ja Ja Ja, y te dices ser un cazador recolector.";
        texto[2] = "Bueno, da igual te explicare. La estólica es un artefacto de caza#que me permite tirar dardos, que son una especie de arma punzante# pequeña que se arrojan en el animal.";
        texto[3] = "Mientras que el madero que sujeta los dardos me facilita un#mejor impulso del dardo que se arroja con gran impacto contra#el animal.";
        texto[4] = "Y... ¿Qué me dices?¿Te gustaría poder obtener una?#Solo debes seguir mis instrucciones y estarás listo para poder#confeccionar tu estólica de madera!";
        texto[5] = "[Ahora puedes confeccionar Estólica de madera]";
        break;
    
    case "espiritu_agua3":
        texto[0] = "Espíritu de Agua: Al parecer eres digno Amaru, tu corazón es puro.#Me recuerda a un mortal que conocí hace mucho tiempo... perdón#nostalgia. Bueno debemos detener a Khoru, él está intentando ";
        texto[1] = "Espíritu de Agua: despertar el poder de Tunupa el dios de la creación.#Con tal poder no solo destruirá tu legado cultural, sino que también#desequilibrara el mundo de los espíritus con el mundo mortal.";
        texto[2] = "Espíritu de Agua: ¡Es imperativo detenerlo! Rápido debemos hablar con#mi hermano el Espiritu de Fuego lo haz visto dentro de las Cuevas de#Anzota. Con su ayuda tendremos la posibilidad de detener sus planes.";
        break;
    
    case "espiritu_agua2":
        texto[0] = "Espíritu de Agua: ¡Soy el espíritu del agua protector del océano...# Bueno mortal has mostrado el respeto de esta tierra.#Te guiaré tu  jornada, pero antes debes demostrar que eres digno.";
        texto[1] = "Espíritu de Agua: ¡Prepárate para luchar, asi podre ver la pureza de tu#corazón.¡Que esperas mortal! Lanza tu mejor ataque.";
        break;
    
    case "espiritu_agua1":
        texto[0] = "Espíritu de Agua: Alejate de mi mortal, si quieres vivir.#Estos invasores han profanado nuestra cultura y ensuciado nuestras#tierras.";
        break;
    
    case "espiritu_fuego3":
        texto[0] = "Espíritu de Fuego:¡¿He sido derrotado por un mortal?! ... A lo mejor es tu#destino detener a Khoru. ¡Sabes! antes él era un ser puro de corazón era#el más amable de la aldea.";
        texto[1] = "Espíritu de Fuego: Mi hermana comenzó a hablarle, encontró pureza en#su corazón y con el tiempo el demostró tener habilidades para honrar#a los mortales que pasaban a otra vida.";
        texto[2] = "Espíritu de Fuego: Entonces mi hermana comenzó a convencernos a#enseñarle  el ritual fúnebre que actualmente realiza tu cultura. Khoru#es el primer mortal en purificar los espíritus a través del ritual de#momificación.";
        texto[3] = "Espíritu de Fuego: Al pasar el tiempo consiguió un aprendiz#¿Quien fue dices? él ha estado contigo todo el tiempo. Sí, es Whanku#y juntos empezaron a jugar con fuerzas que no comprenden.";
        texto[4] = "Espíritu de Fuego: Ellos comenzaron a estudiar las momias, corrompiendo#así el ritual fúnebre. Decían que era con el propósito de beneficiar#el mundo espiritual y el mortal, que podriamos encontrar equilibro.";
        texto[5] = "Espíritu de Fuego: Todo fue mentira, ellos querían obtener un poder#divino, el de Tunupa para poder crear un mundo nuevo. Lo que no#sabían, es que para crear mundo nuevo se debe destruir el mundo que#vivimos. Los espíritus y cada ser de este mundo estaría condenado.";
        texto[6] = "Espíritu de Fuego: Bueno demostraste tu pureza te ayudare a detener#a Khoru, pero si intentas traicionar de nuevo mi confianza solo#por un segundo yo me encargaré de destruirte.";
        texto[7] = "Espíritu de Fuego: El debe estar en el Morro, ¿Por qué en el Morro?#Bueno es porque siento la mayor cantidad de energia espiritual# debemos ir rapidamente el debe estar realizando el ritual para obtener#el poder de Tunupa.";
        break;
    
    case "espiritu_fuego2":
        texto[0] = "Espíritu de Fuego: Aun que  mis hermanos estén para apoyarte mortal#no recibirás mi ayuda. Ya hemos sido engañados por tu especie antes#y no volverá a ocurrir. Ahh ¿No te contaron toda la historia?";
        texto[1] = "Espíritu de Fuego: Antes de ti existía otro ser “puro” como tú, pero este#como todos los humanos fue débil y reveló secretos que no debieron# haber salido a la luz, ahora estamos en esta situación.";
        texto[2] = "Espíritu de Fuego: JA-JA-JA ¡¿quieres detener a Khoru?!#Debo admitir que tienes agallas, prepárate para enfrentarme quiero ver#tu pureza.";
        texto[3] = "Espíritu de Fuego: Yo el Espíritu del Fuego protector de la luz no#dejare que los mortales jueguen con nosotros.";
        break;
    
    case "espiritu_fuego1":
        texto[0] = "Espíritu de Fuego:¡Aléjate de mí! o serás incinerado por mi poder,...";
        texto[1] = "Espíritu de Fuego: Ni siquiera has ido a hablar con mi hermano el Espíritu#del Agua no me interesa tus propósito no quiero hablar contigo y# sobre todo con ese traidor de Whanku.";
        texto[2] = "Espiritu de Fuego: Tu y ese traidor son responsable de todo esto# ¿Por qué ustedes quisieron jugar con los espíritus? Aléjate Whanku#o te destruiré.";
        break;
    
    case "Khoru2":
        texto[0] = "Khoru: No permitiré que un crio detenga mis planes.No sabes#nada sobre mí porque hago todo esto#¿Crees que yo elegí este camino?";
        texto[1] = "Khoru: Ahora llegara un tiempo en que no seremos esclavos de los #espíritus. Con el poder de Tunupa podre doblegarlos y así podre salvarla... ";
        texto[2] = "Khoru: Utilice a los tojotojones para robar las momias y así poder lograr#mi cometido. Ahora enfréntate al poder Absoluto.";
        break;
    
    case "Khoru3":
        texto[0] = "Khoru: Noooooooooooooooooooo.#¿Por qué paso todo esto? estaba tan cerca no pude salvarla# niño tonto ellos te utilizaran como me utilizaron a mi y a Whanku.";
        texto[1] = "Khoru: Ellos contaron solo su parte de la historia....#Tu traidor nunca entendiste mi pesar...";
        break;
    
    case "Khoru":
        texto[0] = "Khoru: ¡No permitiré que un niño detenga mis planes y menos whanku#No sabes nada sobre mí, el  por qué hago todo esto#¿Crees que yo elegí este camino?";
        break;
    
    case "espiritu_luna2":
        texto[0] = "Espíritu de la Luna: No permitiré que un sujeto como tu avance más#por estas costas,es hora que sientan la ira de los espíritus,#el ser humano no debe jugar con fuerzas que no entiende. ";
        texto[1] = "Espíritu de la Luna: Prepárate para sufrir la ira de los espíritus.";
        break;
    
    case "espiritu_luna3":
        texto[0] = "Espíritu de la Luna: Perdóname por esta intromisión pero debes entender#lo que ha ocurrido. Un mortal llamado Khoru, esta profanando#el ritual fúnebre de nuestro ancestro.";
        texto[1] = "Espíritu de la Luna: Está utilizando a los tojotojones para robar momias.#No sabemos el porqué de esta profanación imperdonable, debemos#salvar nuestra cultura mortal te apoyare en esta jornada debemos";
        texto[2] = "Espíritu de la Luna: detener a ese sujeto... #Vamos a las cuevas de Anzota, allí en ese lugar también#están alterando a los espirítus.";
        break;
    
    case "espiritu_luna1":
        texto[0] = "Espíritu de la Luna: ¡Ayúdame mortal! estos tojotojones no deberían#perturbar estas costas.";
        break;
    
    case "premio_carta":
        texto[0] = "¡Enhorabuena! Has ganado una nueva herramienta.#Revisa esta herramienta en la opción Ver cartas.";
        break;
    
    case "premio_materiales":
        texto[0] = "¡Enhorabuena! Has ganado un nuevo material.#Revisa tu inventario para ver el nuevo material adquirido.";
        break;
    
    case "espiritu malvado":
        if (instance_exists(obj_control_tutorial))
        {
            texto[0] = "Te sorprende ver el lado oscuro de tu corazon jajajaja";
        }
        else
        {
            texto[0] = "¡Somos tojo-tojones! hemos venido de los aleros a estas costas#para invadir y obtener los recursos de esta fauna.";
            texto[1] = "En nombre de Khoru ¡Sucumbirás ante nuestro poder!";
        }
        
        break;
    
    // Datos de la cultura chinchorro según Bernardo Arriaza y otros: ver fuentes_chinchorro.md
    // Chica junto a la abuela (rm_momificar): preparación de las momias negras
    // nombre "_2": ya entregó el regalo (obj_npc_personaje), se repiten los datos sin "[Recibiste…]"
    case "npc_arcilla":
    case "npc_arcilla_2":
        texto[0] = "Hola Amaru, ayudo a la abuela a preparar a nuestros difuntos.#Junto a nuestros refugios tenemos todo lo necesario:#arcillas, fibras, cuchillos, pinturas, cuerdas y agua.";
        texto[1] = "Con arcilla gris moldeamos todo el cuerpo, para devolverle#el volumen que perdió. Así queda firme, como una estatua.";
        texto[2] = "Después lo pintamos con una pasta negra de óxido de manganeso,#usando brochas de fibra vegetal. Así queda negro y brillante.";
        texto[3] = "En la cara marcamos los ojos con un palito delgado, y la nariz#y la boca con pequeños orificios. Las dejamos con los ojos y la boca#abiertos, como si siguieran con vida.";
        
        if (npc == "npc_arcilla")
            texto[4] = "Toma, llévate un poco de arcilla para que practiques.#[Recibiste 2 Arcilla].";
        break;
    
    // El del pescado (rm_momificar): la pesca
    // nombre "_2": ya entregó el regalo (obj_npc_personaje), se repiten los datos sin "[Recibiste…]"
    case "npc_pesca":
    case "npc_pesca_2":
        texto[0] = "¡Mira lo que saqué del mar! Somos pescadores,#y el mar nos da casi todo lo que comemos.";
        texto[1] = "Pescamos con anzuelos hechos de espinas de cactus curvadas,#y también de concha y de hueso. Para los peces más grandes#usamos arpones y propulsores.";
        texto[2] = "Muchos pescadores de la costa tenemos un pequeño bulto de hueso#dentro del oído. Dicen que es por bucear tanto en el agua fría.";
        
        if (npc == "npc_pesca")
            texto[3] = "Para amarrar los anzuelos usamos cuerdas de fibra vegetal.#Ten, aquí tienes un poco.#[Recibiste 2 Fibra vegetal].";
        else
            texto[3] = "Para amarrar los anzuelos usamos cuerdas de fibra vegetal.";
        break;
    
    // Pescador de los mariscos (rm_momificar)
    // nombre "_2": ya entregó el regalo (obj_npc_personaje), se repiten los datos sin "[Recibiste…]"
    case "npc_moluscos":
    case "npc_moluscos_2":
        texto[0] = "Yo me dedico a mariscar entre las rocas:#choros, locos y otros moluscos que se pegan a la roca.";
        texto[1] = "Con las conchas de los choros también hacemos anzuelos,#y collares y pulseras para adornarnos.";
        
        if (npc == "npc_moluscos")
            texto[2] = "Ten estos choros, te pueden servir.#[Recibiste 2 Choros].";
        break;
    
    // Pescador de la izquierda (rm_momificar): la vida en la costa
    // nombre "_2": ya entregó el regalo (obj_npc_personaje), se repiten los datos sin "[Recibiste…]"
    case "npc_costa":
    case "npc_costa_2":
        texto[0] = "Somos un grupo de pescadores, cazadores y recolectores de la costa.#Aquí tenemos todo lo que necesitamos.";
        texto[1] = "Nuestros refugios son de palos, cubiertos con pieles#de animales marinos y totora.";
        
        if (npc == "npc_costa")
            texto[2] = "Con fibra vegetal tejemos esteras, cuerdas y faldellines.#Toma esta madera, te servirá para tus herramientas.#[Recibiste 2 Madera].";
        else
            texto[2] = "Con fibra vegetal tejemos esteras, cuerdas y faldellines.";
        break;
    
    // Desafío de Khoru en rm_momificar (obj_khoru_camarones, obj_wanku_guia). Período Arcaico temprano: "grupo", no "pueblo".
    case "wanku_camarones_intro":
        texto[0] = "Amaru, estamos en Camarones. Aquí nuestro grupo realizó la primera#ceremonia para honrar a sus ancestros: la momificación.";
        texto[1] = "Desde hace muchas generaciones, en esta costa, preparamos a nuestros#muertos para que sigan acompañando a la familia.";
        texto[2] = "Explora la zona y habla con la gente. Ellos te enseñarán nuestra#cultura y te darán materiales para la ceremonia.";
        texto[3] = "Empieza por la abuela: ella sabe todo sobre la ceremonia.";
        break;
    
    case "wanku_camarones_cartas":
        texto[0] = "¡Espera, Amaru! Para enfrentar a Khoru necesitas un mazo.";
        texto[1] = "Toma estas cartas de Arpón de hueso.#[Recibiste 5 cartas de Arpón de hueso].";
        texto[2] = "Debes equipar 5 cartas para empezar el desafío de Khoru.#Te abro el menú en Ver cartas.";
        break;
    
    case "wanku_camarones_cartas_2":
        texto[0] = "Recuerda: debes equipar 5 cartas para empezar el desafío de Khoru.#Te abro el menú en Ver cartas.";
        break;
    
    case "khoru_camarones_llamado":
        texto[0] = "¡Eh, tú! El que anda juntando ornamentos para los ancestros.#Ven acá, quiero hablar contigo.";
        break;
    
    case "npc_espera_abuela":
        texto[0] = "Antes de nada, ve a hablar con la abuela.#Ella sabe todo sobre la ceremonia.";
        break;
    
    case "khoru_camarones_desafio":
        texto[0] = "Así que tú eres el que anda preguntando por las viejas costumbres.";
        texto[1] = "Con esos ornamentos no alcanzarás a honrar a tus ancestros.#Si quieres lo que falta, demuéstrame que sabes pelear.";
        texto[2] = "Veamos qué haces contra uno de mis tojotojones.";
        break;
    
    case "khoru_camarones_desafio_2":
        texto[0] = "¿Ya estás listo? Mi tojotojón te espera.";
        break;
    
    case "khoru_camarones_premio":
        texto[0] = "Hmm... no lo hiciste nada mal.";
        // Lo que falta para la momia, calculado al ganar (obj_khoru_camarones.calcular_premio)
        if (global.khoru_premio_texto != "")
            texto[1] = "Toma, con esto podrás terminar tu ceremonia.#" + global.khoru_premio_texto;
        else
            texto[1] = "Ya tienes todo lo que necesitas para tu ceremonia.";
        texto[2] = "Pero no te confíes. Para enfrentarme de verdad necesitarás el poder#de los tres espíritus: la luna, el agua y el fuego. Hasta entonces.";
        break;
    
    case "wanku_camarones_guia":
        texto[0] = "Bien hecho, Amaru. Khoru es fuerte, pero hoy diste el primer paso.";
        texto[1] = "Ahora habla con la anciana para preparar la ceremonia.";
        texto[2] = "Y mira: llegó gente a la playa. Pescadores, recolectores y un cazador#te enseñarán a fabricar sus herramientas.";
        break;
    
    // NPC de recetas de rm_momificar (obj_npc_personaje con receta): "_2" al volver a hablar, sin el aviso
    case "receta_anzuelo_hueso":
    case "receta_anzuelo_hueso_2":
        texto[0] = "Con huesos de ave tallados se hacen buenos anzuelos. Se amarran#con cuerdas de fibra vegetal y se les ata una piedra#para que se hundan en el mar.";
        
        if (npc == "receta_anzuelo_hueso")
            texto[1] = "Te enseñaré a hacerlo, así podrás pescar como nosotros.#[Ahora puedes confeccionar Anzuelo de hueso de ave]#[Recibiste 2 Fibra vegetal y 3 Huesos de ave].";
        break;
    
    case "receta_anzuelo_concha":
    case "receta_anzuelo_concha_2":
        texto[0] = "Desde estas rocas recolectamos peces y mariscos.#Es uno de los mejores lugares de la costa.";
        
        if (npc == "receta_anzuelo_concha")
            texto[1] = "Con la concha de los choros, tallada y amarrada con fibra vegetal,#también se hacen anzuelos. Mira cómo se hace.#[Ahora puedes confeccionar Anzuelo de concha]#[Recibiste 1 Fibra vegetal y 2 Choros].";
        else
            texto[1] = "Con la concha de los choros, tallada y amarrada con fibra vegetal,#también se hacen anzuelos.";
        break;
    
    case "receta_chope":
    case "receta_chope_2":
        texto[0] = "Entre las rocas se sacan locos, choros y otros mariscos.#Para despegarlos usamos el chope.";
        
        if (npc == "receta_chope")
            texto[1] = "Es una herramienta curva, hecha de costilla de lobo marino,#que entra bajo el marisco pegado a la roca.#[Ahora puedes confeccionar Chope de lobo de mar]#[Recibiste 3 Fibra vegetal y 1 C. lobo de mar].";
        else
            texto[1] = "Es una herramienta curva, hecha de costilla de lobo marino,#que entra bajo el marisco pegado a la roca.";
        break;
    
    case "receta_estolica":
    case "receta_estolica_2":
        texto[0] = "¡Shhh! Estoy buscando algún animal para cazar.";
        
        if (npc == "receta_estolica")
            texto[1] = "Uso la estólica: un madero que impulsa los dardos#para lanzarlos más lejos y con más fuerza.#[Ahora puedes confeccionar Estólica de madera]#[Recibiste 3 Madera y 2 Fibra vegetal].";
        else
            texto[1] = "Uso la estólica: un madero que impulsa los dardos#para lanzarlos más lejos y con más fuerza.";
        break;
    
    case "npc":
        texto[0] = "Hola Amaru mi nombre es Suyai, seré tu guía para este viaje estaré#contigo para averiguar mas sobre nuestra cultura y la de estos#nuevos invasores.#Recuerda siempre estaré contigo para poder guiarte en esta jornada.";
        texto[1] = "Wanku el espíritu de la sabiduría y nuestro guardián protector# te dará las herramientas y el conocimiento para detener esta locura#y salvar nuestra cultura. Confió en que podrás derrotar al oscuro chamán.";
        break;
    
    // La abuela sin los materiales del minijuego (obj_npc_1): se arma con lo que falta en este momento
    case "npc1_falta":
        // Explica la ceremonia, invita a participar y da la lista de lo que falta
        texto[0] = "Hola, joven. Soy una de las sabias de nuestro grupo. Mi deber es#enseñar a honrar a nuestros ancestros preparando a nuestros muertos.";
        texto[1] = "Limpiamos el cuerpo, lo armamos con maderos y fibras, lo cubrimos#de arcilla y le ponemos una máscara, para que siga junto a la familia.";
        texto[2] = "¿Quieres participar? Para ello necesitas:";
        texto[3] = scr_momia_faltantes() + ".";
        texto[4] = "Las piezas se hacen en Creación, en el menú de pausa, con madera,#fibra vegetal y arcilla. La gente de esta playa te puede ayudar.";
        texto[5] = "Vuelve cuando tengas todo.";
        break;
    
    // rm_momificar: la anciana ya se presentó (obj_khoru_camarones.texto_anciana)
    case "anciana_falta":
        texto[0] = "Aún te falta:#" + scr_momia_faltantes() + ".";
        texto[1] = "Junta madera, fibra vegetal y arcilla. La gente de esta playa#te puede ayudar.";
        break;
    
    case "anciana_materiales":
        texto[0] = "¡Ya tienes todos los materiales! Vamos a crear los insumos#necesarios para hacer nuestro primer ritual.";
        break;
    
    case "anciana_lista":
        texto[0] = "¡Manos a la obra!";
        break;
    
    case "npc1":
        // "Chinchorro" es el nombre que les dieron los arqueólogos en el siglo XX: ellos no se llamaban así
        texto[0] = "Hola, joven. Soy una de las sabias de nuestro grupo. Mi deber es#enseñar a honrar a nuestros ancestros preparando a nuestros muertos.";
        texto[1] = "Limpiamos el cuerpo, lo armamos con maderos y fibras, lo cubrimos#de arcilla y le ponemos una máscara, para que siga junto a la familia.";
        texto[2] = "Ya tienes todo lo necesario. ¿Quieres participar? Sigue mis#indicaciones y lo haremos juntos. ¡Manos a la obra!";
        break;
    
    case "npc2":
        texto[0] = "Nos situamos entre la rocas para tener una mejor vision #para la recolecta.";
        texto[1] = "Este lugar es una de la zonas más estratégicas para#la recolección de peces y mariscos.";
        texto[2] = "Ten con estos podras pescar con mayor facilidad.# también obten esto no me lo agradezcas.";
        texto[3] = "[Ahora puedes confeccionar Anzuelo de Choros].";
        break;
    
    case "npc3":
        texto[0] = "La capilla: #Campamento que cumplía la función económica y ritual donde se #realizaban las ceremonias en torno al proceso de iniciación";
        texto[1] = "de joven a adulto. Esto se simbolizaba a través de un faldellín que #reflejaba el proceso de cambio que se generaba en el individuo.";
        texto[2] = "El faldellín era confeccionado a través de fibra vegetal #y en algunas ocasiones con fibra de camélido y #cubría la parte púbica de los miembros del grupo chinchorro.";
        break;
    
    case "npc4":
        texto[0] = "Entre la rocas uno puede extraer frutos del mar #como lo es los locos, choros u otros mariscos ¿Pero sabes cómo extraer#dichas especias? Jajaja no te preocupes para esto uno utiliza el Chope";
        texto[1] = "Y me diras ¿Que es el Chope?# Bueno amigo mío es una de las herramientas que más utilizamos#para la caza marina sobre todo para los moluscos.";
        texto[2] = "El proceso consiste en despegar el marisco pegados en la roca #Es por eso que el chope tiene una forma curvada para poder extraerlos# en cualquier parte que este incrustado en la roca.";
        texto[3] = "Toma esto te puede servir en tu jornada#[Ahora puedes confeccionar Chope de lobo de Mar].";
        break;
    
    case "wanku_suyai":
        texto[0] = "Amaru, debes conocer a alguien que tiene tu mismo don.#Me refiero a la chica que está en esa choza.";
        break;

    case "wanku_mazo":
        texto[0] = "¡Esperen, chicos! No pueden enfrentarse a los tojotojones sin sus cartas.";
        texto[1] = "Vayan al menú, entren a Ver cartas y armen#un mazo de al menos 4 cartas.";
        break;
    
    case "wanku_tutorial":
        if (obj_control_tutorial.paso == 32)
        {
            texto[0] = "Esto no tiene buena pinta...";
            texto[1] = "¡Amaru!, debemos volver al Humedal de#inmediato y prepararnos.#Se aproximan tiempos oscuros, y me temo que algo grande va ocurrir.";
        }
        
        if (obj_control_tutorial.paso == 30)
            texto[0] = "Khoru: Wanku, preparate para una nueva era, en donde no seremos#mas esclavos de los espíritus. Nos veremos pronto viejo amigo.";
        
        if (obj_control_tutorial.paso == 28)
        {
            texto[0] = "Khoru: ¿Asi que este es tu títere para derrotarme? Niño si supieras#la verdad que esconde nuestra cultura, como los espíritus nos han#manipulado. Whanku tu antes pensabas como yo.";
            texto[1] = "Whanku: Khoru, no sucumbira ante tus mentiras el es un ser puro#y  te detendrá ...";
            texto[2] = "Khoru: Por mi esta bien, veremos quién de los dos tiene una mejor#convicción, nos veremos jovencito JA-JA-JA-JA-JA.";
        }
        
        if (obj_control_tutorial.paso == 26)
        {
            texto[0] = "Desconocido : Tanto tiempo sin verte viejo amigo.";
            texto[1] = "Whanku : ¡Khoru!, no puede ser.#Eres tu responsable de esta anomalia?";
            texto[2] = "Khoru: ...";
        }
        
        if (obj_control_tutorial.paso == 25)
        {
            texto[0] = "Voz desconocida : JA JA JA JA JA JA";
            texto[1] = "Whanku : Quien anda ahi?";
        }
        
        if (obj_control_tutorial.paso == 17)
        {
            texto[0] = "Espiritu : MUERE MUERE MUERE";
            texto[1] = "Wanku : ¿Pero que?!, Que espiritu mas violento,#será que...no puede ser..., Esquiva sus ataques!!";
            texto[2] = "Wanku : Contrataca haciendo uso de tus herramientas!.";
            texto[3] = "MUÉVETE CON W A S D.  ATACA CON CLIC IZQUIERDO.#CAMBIA DE CARTA CON LA RUEDA DEL MOUSE.#CON JOYSTICK XBOX: ANÁLOGO L, BOTÓN A Y LB / RB.";
            break;
        }
        
        if (obj_control_tutorial.paso == 14)
        {
            texto[0] = "(Durante el juego cada herramienta es representada con una carta).#(Esta nos permite combatir al enemigo y asi poder derrotarlo).#(Cada carta tiene una característica especial).";
            texto[1] = "Tenemos que poner a prueba tus habilidades.#¡Manos a la obra!";
            texto[2] = "Te acabo de entregar 4 cartas de Arpón de hueso ya hechas.#Se suman a tu carta en el inventario.";
            texto[3] = "Agrégalas a tu mazo desde 'Editar mazo'.#( si no equipas un número mínimo de 5 cartas en tu mazo#no podrás combatir)";
            break;
        }
        
        if (obj_control_tutorial.paso == 13)
        {
            texto[0] = "Entrenaremos con un espiritu de batalla que nos ayudará.#Pero para esto, necesitamos perfeccionar nuestras herramientas.# Por mientras, obtén algunas mías.  ";
            break;
        }
        
        if (obj_control_tutorial.paso == 8)
        {
            texto[0] = "Aprenderás a confeccionar un arpón con hueso de ave,#ya que este será muy útil para tu aventura. ";
            texto[1] = "Para lograr esto, debes ocupar fibra vegetal y huesos de ave. #Esto nos servirá para la pesca, recolección y la caza terrestre.";
            texto[2] = " HAZ CLIC EN EL BOTÓN DE MENÚ (ARRIBA A LA IZQUIERDA)#UNA VEZ TERMINADO EL TEXTO";
            break;
        }
        
        if (obj_control_tutorial.paso == 5)
        {
            texto[0] = "Bueno, es hora de que me muestres tus herramientas.  #¡¿No tienes ninguna herramienta?! bueno entonces, acompañame.";
            texto[1] = "¿No hay materia prima por los alrededores?# ¿Y que son los materiales  que veo arrojados en la orilla?.";
            break;
        }
        
        if (obj_control_tutorial.paso == 4)
        {
            texto[0] = "¡Hey! ¡Estoy aqui abajo!, ¡Cruza el rio!";
            texto[1] = "Cuando ya encuentres que puedes moverte con facilidad #¡Ven a hablar conmigo!";
            break;
        }
        
        if (obj_control_tutorial.paso == 2)
        {
            texto[0] = "¡Hola Joven Chinchorro! Permíteme presentarme, mi nombre es# Wanku y estoy aquí para darte la bienvenida.";
            texto[1] = "A continuación estarás a punto de vivir unas de las experiencias#más fantásticas e importante para la comunidad,#conocida como “cultura Chinchorro”.";
            texto[2] = "Además déjame comentarte, que este grupo habitó desde el Norte #Grande de Chile llegando hasta la región de Antofagasta... #extendiéndose hasta el sur del Perú. ";
            texto[3] = "en el periodo prehispánico, con data desde los 9000 hasta los #5000  Antes de Cristo. Además, debo mencionarte, que este grupo #es conocido... ";
            texto[4] = " por ser unos de los primeros habitantes cazadores-recolectores# que ocuparon la región, debido a las evidencias en pesca y #recolección marina (como moluscos, locos, chorus, etc).";
            texto[5] = "Bueno sin más rodeos, te enseñare ahora como vive un ser#de esta zona. ¿Estás listo? ¡Vamos! ¡Manos a la obra!";
            texto[6] = "MUÉVETE CON FLECHAS DIRECCIONALES DEL TECLADO.#MUÉVETE CON EL ANÁLOGO L, SI ESTAS CON JOYSTICK XBOX.";
            break;
        }
}
}
