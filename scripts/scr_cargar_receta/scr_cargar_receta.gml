function scr_cargar_receta() {
ini_open("recetas.ini");
var data = 0;
data[0] = 5;
data[1] = ini_read_string("arpon_hueso", "materialA", "No material");
data[2] = ini_read_string("arpon_hueso", "materialB", "No material");
data[3] = ini_read_string("arpon_hueso", "materialC", "No material");
data[4] = ini_read_real("arpon_hueso", "cantidadA", 0);
data[5] = ini_read_real("arpon_hueso", "cantidadB", 0);
data[6] = ini_read_real("arpon_hueso", "cantidadC", 0);
data[7] = "Arpon de hueso";
data[8] = "Usado para la caza de peces y pequeñas#aves, confeccionado con hueso de ave y#cuerdas de fibra vegetal. ";
data[9] = ini_read_real("arpon_hueso", "cant", 0);
data[10] = ini_read_real("arpon_hueso", "enable", 0);
ds_list_add(recipeBook, data);
global.escena = 0;
data = 0;
data[0] = 11;
data[1] = ini_read_string("anzuelo_huesoAve", "materialA", "No material");
data[2] = ini_read_string("anzuelo_huesoAve", "materialB", "No material");
data[3] = ini_read_string("anzuelo_huesoAve", "materialC", "No material");
data[4] = ini_read_string("anzuelo_huesoAve", "cantidadA", "No one");
data[5] = ini_read_string("anzuelo_huesoAve", "cantidadB", "No one");
data[6] = ini_read_string("anzuelo_huesoAve", "cantidadC", "No one");
data[7] = "Anzuelo hueso de ave";
data[8] = "Usado para el arte de la pesca, esta#herramienta artesanal se confecciona#a través de hueso de ave y cuerdas de fibra#vegetal, se amarran dos piedras para poder#hundirse debajo del agua y así poder#extraer los peces en el mar.";
data[9] = ini_read_real("anzuelo_huesoAve", "cant", 0);
data[10] = ini_read_real("anzuelo_huesoAve", "enable", 0);
ds_list_add(recipeBook, data);
data = 0;
data[0] = 9;
data[1] = ini_read_string("estolica_madera", "materialA", "No material");
data[2] = ini_read_string("estolica_madera", "materialB", "No material");
data[3] = ini_read_string("estolica_madera", "materialC", "No material");
data[4] = ini_read_real("estolica_madera", "cantidadA", 0);
data[5] = ini_read_real("estolica_madera", "cantidadB", 0);
data[6] = ini_read_real("estolica_madera", "cantidadC", 0);
data[7] = "Estolica de Madera";
data[8] = "Extension de brazo para facilitar la caza#terrestre para atrapar avecillas o#animales de pequeño tamaño.";
data[9] = ini_read_real("estolica_madera", "cant", 0);
data[10] = ini_read_real("estolica_madera", "enable", 0);
ds_list_add(recipeBook, data);
data = 0;
data[0] = 1;
data[1] = ini_read_string("anzuelo_choro", "materialA", "No material");
data[2] = ini_read_string("anzuelo_choro", "materialB", "No material");
data[3] = ini_read_string("anzuelo_choro", "materialC", "No material");
data[4] = ini_read_real("anzuelo_choro", "cantidadA", 0);
data[5] = ini_read_real("anzuelo_choro", "cantidadB", 0);
data[6] = ini_read_real("anzuelo_choro", "cantidadC", 0);
data[7] = "Anzuelo de concha";
data[8] = "Anzuelo confeccionado a base de conchas#de choro tallado y amarrado con una cuerda#de fibra vegetal. Artefacto para la captura#de peces, normalmente estan amarrados#con piedrecillas para que pueda hundirse#en el mar.";
data[9] = ini_read_real("anzuelo_choro", "cant", 0);
data[10] = ini_read_real("anzuelo_choro", "enable", 0);
ds_list_add(recipeBook, data);
data = 0;
data[0] = 7;
data[1] = ini_read_string("chope_lobo", "materialA", "No material");
data[2] = ini_read_string("chope_lobo", "materialB", "No material");
data[3] = ini_read_string("chope_lobo", "materialC", "No material");
data[4] = ini_read_real("chope_lobo", "cantidadA", 0);
data[5] = ini_read_real("chope_lobo", "cantidadB", 0);
data[6] = ini_read_real("chope_lobo", "cantidadC", 0);
data[7] = "Chope Lobo de mar";
data[8] = "Herramienta confeccionada por costillas de#lobo marino, esta se utiliza para la#extracción de moluscos incrustados en los#roqueríos costeros de la zona.";
data[9] = ini_read_real("chope_lobo", "cant", 0);
data[10] = ini_read_real("chope_lobo", "enable", 0);
ds_list_add(recipeBook, data);
ini_close();
}
